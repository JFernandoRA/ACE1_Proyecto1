# Modo inicial para desarrollar sin Raspberry Pi, MongoDB ni EMQX.
VITE_USE_MOCK_DATA=false

# Al conectar EMQX, cambia VITE_USE_MOCK_DATA a false y completa estos valores.
# En EMQX Cloud Serverless la URL normalmente usa wss, puerto 8084 y ruta /mqtt.
VITE_MQTT_URL=wss://k61f16b6.ala.us-east-1.emqxsl.com:8084/mqtt
VITE_MQTT_USERNAME=edificio_dashboardReact
VITE_MQTT_PASSWORD=controlRemoto1
VITE_MQTT_CLIENT_PREFIX=edificio_dashboard

# Se utilizará en la siguiente fase para consultar históricos de MongoDB.
VITE_API_URL=http://localhost:5000/api